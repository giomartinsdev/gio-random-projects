APP_PORT=5000
REGISTRY_VERSION=2
HTPASSWD_INIT_VERSION=2.4-alpine

# Required — the registry refuses to boot without REGISTRY_PASSWORD set
# (htpasswd-init has nothing to hash otherwise). This is what `docker
# login` needs on the client side, e.g.:
#   docker login registry.giomartins.dev -u admin -p <this value>
REGISTRY_USER=admin
REGISTRY_PASSWORD=change-this-password
