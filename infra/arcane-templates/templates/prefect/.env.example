APP_PORT=4200
PREFECT_VERSION=3-latest
# This is what the BROWSER calls, not the container — if you put Prefect
# behind a domain/tunnel/reverse proxy, set this to that public URL
# (e.g. https://prefect.example.com/api), or the UI tries to reach
# localhost on the visitor's own machine and never connects.
PREFECT_UI_API_URL=http://localhost:4200/api
PREFECT_WORK_POOL=docker-pool
