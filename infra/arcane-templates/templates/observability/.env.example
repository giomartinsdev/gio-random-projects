GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password
# Set to your public URL (e.g. https://observability.example.com) once you
# put Grafana behind a domain/tunnel — same reasoning as Prefect/Arcane:
# a wrong value here breaks the UI's own links back to itself, though
# (unlike Prefect) Grafana's core pages still work fine without it.
GRAFANA_ROOT_URL=http://localhost:3000

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090

# MinIO ships bundled with this stack now — it's what dashboards-as-code
# runs on: drop a dashboard JSON into the MINIO_DASHBOARDS_BUCKET bucket
# and it shows up in Grafana (folder "MinIO") within ~10s, no restart
# needed. A sidecar (dashboards-sync) mirrors the bucket into Grafana's
# local provisioning path since Grafana can't read S3 directly, reaching
# MinIO over this compose's own internal network (no public tunnel, no
# Cloudflare Access token involved).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DASHBOARDS_BUCKET=grafana-dashboards

LOKI_VERSION=3.3.2
TEMPO_VERSION=2.9.0
PROMETHEUS_VERSION=latest
OTEL_VERSION=latest
GRAFANA_VERSION=latest
MC_VERSION=latest
MINIO_VERSION=latest
