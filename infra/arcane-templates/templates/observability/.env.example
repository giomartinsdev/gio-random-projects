GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password
# Set to your public URL (e.g. https://observability.example.com) once you
# put Grafana behind a domain/tunnel — same reasoning as Prefect/Arcane:
# a wrong value here breaks the UI's own links back to itself, though
# (unlike Prefect) Grafana's core pages still work fine without it.
GRAFANA_ROOT_URL=http://localhost:3000

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090

LOKI_VERSION=3.3.2
TEMPO_VERSION=2.9.0
PROMETHEUS_VERSION=latest
OTEL_VERSION=latest
GRAFANA_VERSION=latest
