APP_PORT=8978
CLOUDBEAVER_VERSION=latest

# Name of the OTHER project's compose network to join — that project's
# Postgres is what actually gets browsed. Compose names a project's
# default network "<project-dir>_default" unless overridden; confirm
# with `docker inspect <postgres-container> --format '{{json .NetworkSettings.Networks}}'`
# if unsure.
DB_NETWORK=domain_default
