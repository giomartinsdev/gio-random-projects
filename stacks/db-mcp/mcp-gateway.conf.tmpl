# Gateway do MCP do banco (db-mcp). Fica entre o ingress e o postgres-mcp.
#
# Por que existe: o postgres-mcp (crystaldba) fala o transporte MCP e NÃO tem
# autenticação própria. Ele fica na rede interna `apps`, sem porta publicada —
# este nginx é a única porta que o ingress alcança (loopback) e o único ponto
# que valida o token.
#
# A validação é um token bearer estático (variável de stack no Dockhand,
# MCP_DB_TOKEN — NUNCA no git). Sem token válido, 401 antes de chegar ao MCP.
# O __MCP_DB_TOKEN__ é substituído no boot pelo entrypoint (sed); o valor real
# nunca aparece no git.
map_hash_bucket_size 256;
map $http_authorization $mcp_authorized {
    default 0;
    "Bearer __MCP_DB_TOKEN__" 1;
}

server {
    listen 8000;
    server_name _;

    # Health check sem token (para o healthcheck do compose/ingress).
    location = /healthz {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        if ($mcp_authorized = 0) {
            return 401 '{"error":"unauthorized"}';
        }

        # SSE do MCP: /sse (event stream) + /messages (envio). Repassa tudo.
        proxy_pass http://db-mcp:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE: sem buffer e timeout longo.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Connection "";
    }
}
