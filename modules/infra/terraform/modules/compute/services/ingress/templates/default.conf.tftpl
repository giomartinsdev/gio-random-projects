map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Crawlers que desenham o cartão de preview de link (Open Graph). O SPA é
# estático e nenhum deles roda JavaScript, então um link de clube/partida/
# jogador chegaria sem título nem descrição. Para essas requisições, os
# detalhes abaixo mandam para o backend de preview (var.og_api do site) em vez
# do MinIO. A lista é de bots, não de humanos: qualquer outro User-Agent segue
# para o SPA normal.
#   discord: "Mozilla/5.0 (compatible; Discordbot/2.0; +https://discordapp.com)"
#   whatsapp: "WhatsApp/2.x"  |  telegram: "TelegramBot (like TwitterBot)"
map $http_user_agent $is_crawler {
  default 0;
  ~*(facebookexternalhit|Facebot|Twitterbot|Discordbot|WhatsApp|Slackbot|TelegramBot|LinkedInBot|Pinterest|redditbot|Googlebot|bingbot|Applebot|AhrefsBot|GPTBot|ClaudeBot|Embedly|vkShare|W3C_Validator|Mastodon|Bluesky) 1;
}

client_max_body_size 50m;

# Anything with no matching server_name below (a raw IP hit, a
# forgotten hostname) gets dropped rather than falling through to
# whichever service happens to be first -- nginx's default_server
# behavior otherwise.
server {
  listen 80 default_server;
  server_name _;
  return 444;
}

%{ for s in services ~}
server {
  listen 80;
  server_name ${s.hostname};

  location / {
    proxy_pass http://127.0.0.1:${s.port};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Upgrade/Connection cover tela's and any other app's WebSocket
    # endpoints; a plain HTTP request just never sets $http_upgrade, so
    # this is a no-op for everything else.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

%{ endfor ~}

%{ for s in static_sites ~}
server {
  listen 80;
  server_name ${s.hostname};

%{ if try(s.og_api, 0) > 0 ~}
  # Preview de link: um crawler pedindo uma página de detalhe (/club/:id,
  # /match/:id, /player/:id) recebe o HTML com as meta tags do backend
  # (og_api), que é quem tem o dado. Humanos seguem para o SPA no `location /`
  # abaixo -- só o User-Agent de bot casa aqui, então a experiência normal não
  # muda. Sem isto, nenhum dos três tipos de página teria preview em
  # Discord/WhatsApp/X (o SPA é estático e nenhum scraper roda JavaScript).
  #
  # O destino é montado numa variável porque `proxy_pass` com URI dentro de um
  # `if` é o caso que o próprio nginx desaconselha (o if vira uma location
  # aninhada e a URI é tratada de forma não óbvia). Com a URL inteira na
  # variável, `proxy_pass $var` passa exatamente o que está nela -- sem
  # reescrever nada por trás.
  location ~ ^/(club|player|match)/([^/]+)/?$ {
    set $og_route "";
    if ($is_crawler) {
      set $og_route "http://127.0.0.1:${s.og_api}/og/$1/$2";
    }
    if ($og_route = "") {
      set $og_route "http://127.0.0.1:${minio_port}/${s.bucket}/index.html";
    }
    proxy_pass $og_route;
    proxy_set_header Host $host;
  }
%{ endif ~}

  # Static SPA served straight out of MinIO's S3 API (bucket
  # "${s.bucket}"), path-style -- no container behind this hostname at
  # all. Host is deliberately NOT forwarded -- MinIO's path-style API
  # doesn't need it, and passing the public hostname through has no
  # benefit and only risk (a vhost-style misinterpretation on MinIO's
  # side).
  #
  # Can't try_files against a proxied upstream the way a real
  # filesystem would, and error_page 404 doesn't work here either: hit
  # MinIO's S3 API with a trailing-slash (or no-extension) key -- "/"
  # itself included -- and it answers 200 with an XML bucket listing,
  # never a 404, so a fallback keyed on the response code would leak
  # that listing straight to a browser instead of ever firing. Route
  # on the URL's shape instead: anything that looks like a real static
  # asset (ends in a file extension) is fetched by its literal key, a
  # genuinely missing one 404s for real; everything else -- every
  # client-side route, "/" included -- goes straight to index.html.
  location ~ ^/.*\.[a-zA-Z0-9]+$ {
    proxy_pass http://127.0.0.1:${minio_port}/${s.bucket}$uri;
  }

  location / {
    # A bare proxy_pass (no URI part) after rewrite forwards the
    # rewritten URI verbatim -- a prefix location's proxy_pass WITH a
    # URI part instead replaces only the matched prefix and appends
    # whatever's left of the original request path, which for
    # `location /` (matching everything) would tack the entire
    # original path onto the end of "index.html" instead of replacing
    # it.
    rewrite ^ /${s.bucket}/index.html break;
    proxy_pass http://127.0.0.1:${minio_port};
  }
}

%{ endfor ~}
