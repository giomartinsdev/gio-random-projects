# bet-api base URL — container-to-container on the docker network in
# prod (http://bet-api:8009); never the public hostname.
BET_API_URL=http://localhost:8009
# Shared secret presented on /internal/* (X-Runner-Key).
RUNNER_API_KEY=dev-runner-key

# How often to poll for queued bets (ms).
POLL_INTERVAL_MS=5000

# DRY_RUN=1 goes through the WHOLE flow (open link, login, fill stake)
# but never clicks the final confirm — the receipt says dryRun: true.
# For testing selectors without placing real bets.
DRY_RUN=1

# 0 = headless chrome, 1 = headed (local debugging only — no X server
# in the prod container).
HEADED=0

# Log lines above this level get dropped. LOG_LEVEL=debug shows every
# selector attempt.
LOG_LEVEL=info

# Optional OTLP endpoint (traces/metrics); empty = telemetry off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318