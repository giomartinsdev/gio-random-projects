# clubs-api — variáveis de ambiente.
#
# Copie para .env e ajuste. Nenhum valor real aqui.

# --- persistência (obrigatório) -------------------------------------------
# Base da domain-api. Local: o domain-api rodando na sua máquina.
# Produção: http://domain-api:8000 (container-to-container na rede interna).
CLUBS_DOMAIN_API_URL=http://localhost:8000
# A chave DESTE serviço na domain-api. Em produção ela é gerada pelo Terraform
# (random_id.clubs_api_domain_key) e injetada no container; aqui é a sua chave
# de dev. Precisa existir no DOMAIN_API_KEYS do domain-api.
CLUBS_DOMAIN_API_KEY=clubs-api-key

# --- identidade (Cloudflare Access) ---------------------------------------
# Dois modos, e só dois. O serviço RECUSA bootar se você misturar os dois.
#
# MODO PRODUÇÃO (igual ao que vai subir) — verificação real:
#   O team domain do time. É o MESMO que bet-frontend/hub-frontend usam.
# CLUBS_ACCESS_TEAM_DOMAIN=workwithgiomartinsdev.cloudflareaccess.com
#   O aud da aplicação de Access em clubs-api.giomartins.dev/api. Em produção
#   vem do output access_app_auds do módulo Terraform; localmente você pega no
#   painel (Zero Trust → Access → Applications → a app do /api → o AUD).
# CLUBS_ACCESS_AUD=
#
# MODO DEV (só local, nunca em produção) — identidade fixa:
#   Com o bypass ligado, uma requisição sem JWT roda como CLUBS_DEV_USER_EMAIL.
#   Deixe CLUBS_ACCESS_TEAM_DOMAIN VAZIO: ligar os dois faz o serviço recusar
#   bootar de propósito (é o buraco de autenticação mais fácil de criar sem
#   perceber).
# CLUBS_DEV_BYPASS_AUTH=1
# CLUBS_DEV_USER_EMAIL=dev@local

# --- opcionais ------------------------------------------------------------
# Origens permitidas em CORS (a origem do SPA). A primeira também é o destino
# padrão do /api/sso quando o parâmetro return não é utilizável.
CLUBS_FRONTEND_ORIGINS=http://localhost:5173
# Restrição opcional a e-mails específicos, checada depois do JWT verificar.
# Vazio = qualquer conta que a política de Access admitir.
CLUBS_ALLOWED_EMAILS=

PORT=8017
OTEL_SERVICE_NAME=clubs-api
# Vazio desliga a telemetria (local).
OTEL_EXPORTER_OTLP_ENDPOINT=
