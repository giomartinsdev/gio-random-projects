# Copy to .env (or export directly) for local dev. Never commit a
# populated .env -- especially never a real ASSET_MANAGER_BRAPI_TOKEN.

PORT=8022
BIND_HOST=

ASSET_MANAGER_FRONTEND_ORIGINS=http://localhost:5173

# Cloudflare Access verification -- leave empty locally and use the dev
# bypass below instead.
ASSET_MANAGER_ACCESS_ISSUER=
ASSET_MANAGER_ACCESS_AUD=
ASSET_MANAGER_ALLOWED_EMAILS=

# Local-dev auth bypass: with no Cf-Access-Jwt-Assertion header, every
# request runs as this user. Must stay unset in prod.
ASSET_MANAGER_DEV_BYPASS_AUTH=1
ASSET_MANAGER_DEV_USER_EMAIL=dev@local
ASSET_MANAGER_DEV_USER_NOME=Dev

# Shared domain-api (positions/movements persistence).
ASSET_MANAGER_DOMAIN_API_URL=http://127.0.0.1:8000
ASSET_MANAGER_DOMAIN_API_KEY=

# brapi.dev quotes. The real token is an infrastructure secret injected
# by Terraform -- fill it in locally yourself, never commit a value here.
ASSET_MANAGER_BRAPI_TOKEN=<preencha localmente, nunca commitar valor real>
ASSET_MANAGER_BRAPI_BASE_URL=https://brapi.dev/api
