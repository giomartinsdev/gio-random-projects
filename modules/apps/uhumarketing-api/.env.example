# Copie para .env e ajuste. Nenhum valor aqui é secreto de verdade — são
# defaults de desenvolvimento local. Em produção, cada segredo vem do cofre.

# --- Postgres local ---------------------------------------------------------
POSTGRES_USER=uhu
POSTGRES_PASSWORD=uhu
POSTGRES_DB=uhumarketing
POSTGRES_PORT=5433

# --- API -------------------------------------------------------------------
API_PORT=8195
# Porta do stack (nginx serve a SPA e faz proxy de /api para a API).
WEB_PORT=8080

# Não há chave de API: cada conta entra por e-mail/senha e recebe um token de
# sessão (ver README, "Contas e sessão"). As sessões vivem no Postgres.

# Origens que podem chamar a API do navegador. Vazio no stack do compose: a SPA
# é servida pelo nginx na MESMA origem e faz proxy de /api — não há CORS. Só
# preencha se publicar o frontend em outro domínio.
CORS_ORIGINS=

# --- Meta / WhatsApp -------------------------------------------------------
# dry-run: nada sai para a Meta. A fila processa, grava wamid falso e o produto
# inteiro funciona. É o modo para desenvolver sem conta de WhatsApp.
# live: Cloud API de verdade — cada conta ativa o PRÓPRIO WhatsApp em
# Configurações → WhatsApp (WABA ID, Phone Number ID e token). Não existe token
# global: um token do processo faria toda conta nova enviar pelo número do dono
# do servidor.
META_MODE=dry-run

# Chave que cifra (AES-GCM) o token do WhatsApp de cada conta antes de gravar.
# Obrigatória com META_MODE=live. Gere outra em produção — e nunca a perca: sem
# ela os canais precisam ser reativados.
CHANNEL_SECRET=
# URL pública da API (o que a Meta alcança). Em deploy é
# https://uhu.seudominio.com — com HTTPS, porque a Meta não chama http. Vazio
# em localhost: a tela então NÃO mostra callback, em vez de oferecer um endereço
# que a Meta não alcança.
PUBLIC_BASE_URL=
# Assinatura X-Hub-Signature-256 do webhook. Em META_MODE=live é obrigatória: o
# endpoint é público e, sem ela, qualquer um marcaria envio como lido ou forjaria
# opt-out. Sem a chave em live, o webhook recusa evento (503) em vez de aceitar.
# App Settings → Basic → App Secret.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=uhu-dev-verify

# --- Worker ----------------------------------------------------------------
WORKER_INTERVAL_SECONDS=2
# Habilita /dev/reset, /dev/simulate-status e /dev/worker-tick.
# Default do serviço é false; o compose local liga. Em ambiente com dado real,
# deixe false — /dev/reset apaga dados de verdade.
ALLOW_DEV_ACTIONS=true
