# Copie para .env e ajuste. Nenhum valor aqui é secreto de verdade — são
# defaults de desenvolvimento local. Em produção, cada segredo vem do cofre.

# --- Postgres local ---------------------------------------------------------
POSTGRES_USER=uhu
POSTGRES_PASSWORD=uhu
POSTGRES_DB=uhumarketing
POSTGRES_PORT=5433

# --- API -------------------------------------------------------------------
API_PORT=8195

# Não há chave de API: cada conta entra por e-mail/senha e recebe um token de
# sessão (ver README, "Contas e sessão"). As sessões vivem no Postgres.

# Origens que podem chamar a API do navegador.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# --- Meta / WhatsApp -------------------------------------------------------
# dry-run: nada sai para a Meta. A fila processa, grava wamid falso e o produto
# inteiro funciona. É o modo para desenvolver sem conta de WhatsApp.
# live: Cloud API de verdade — cada conta ativa o PRÓPRIO WhatsApp em
# Configurações → WhatsApp (WABA ID, Phone Number ID e token). Não existe token
# global: um token do processo faria toda conta nova enviar pelo número do dono
# do servidor.
META_MODE=dry-run

# Chave que cifra (AES-GCM) o token do WhatsApp de cada conta antes de gravar.
# Obrigatória com META_MODE=live. Gere outra em produção — e nunca a perca: sem
# ela os canais precisam ser reativados.
CHANNEL_SECRET=
# URL pública da API (túnel HTTPS). Sem ela o webhook não chega: o envio
# acontece, mas entregue/lido não voltam. O template então precisa de
# "Consultar status na Meta" na tela.
PUBLIC_BASE_URL=http://localhost:8195
# Assinatura X-Hub-Signature-256 do webhook. Vazio = webhook aceita sem
# assinatura (só é aceitável em localhost).
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=uhu-dev-verify

# --- Worker ----------------------------------------------------------------
WORKER_INTERVAL_SECONDS=2
# Habilita /dev/reset, /dev/simulate-status e /dev/worker-tick.
# Em qualquer ambiente com dados reais, false.
ALLOW_DEV_ACTIONS=true
