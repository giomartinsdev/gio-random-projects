VITE_POST_API_URL=https://post-api.giomartins.dev
VITE_BOOKCLUB_API_URL=https://bookclub-api.giomartins.dev
VITE_CLASSROOM_API_URL=https://classroom-api.giomartins.dev
# Public OTLP endpoint for the browser telemetry (src/telemetry.ts).
# Leave unset for local dev — the SDK init is skipped entirely without it.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.giomartins.dev
# This app's own public origin -- only actually needed inside a Discord
# Activity, where window.location.origin is Discord's discordsays.com
# proxy instead of the real site. See src/lib/useWebRTCBroadcast.ts.
VITE_PUBLIC_APP_URL=https://classroom-bdd.giomartins.dev
# Only needed to test the Discord Activity locally -- the app works
# fine as a normal site with this unset. See src/lib/discordActivity.ts.
VITE_DISCORD_CLIENT_ID=
