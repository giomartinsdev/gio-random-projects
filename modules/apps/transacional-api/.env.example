# Port the HTTP server listens on inside the container.
PORT=8021
# Empty = bind every interface (bare metal / local dev). Set to
# 127.0.0.1 behind an nginx ingress that owns the public interface.
BIND_HOST=

# Comma-separated list of the frontend's own origin(s). Only these are
# answered CORS and only these are valid /api/sso ?return= targets.
TRANSACIONAL_FRONTEND_ORIGINS=http://localhost:5173

# Cloudflare Access verification. Issuer is the team domain
# ("https://<team>.cloudflareaccess.com"); aud is this app's Access
# application audience tag. Leave both empty in local dev with the
# bypass below turned on.
TRANSACIONAL_ACCESS_ISSUER=
TRANSACIONAL_ACCESS_AUD=
# Comma-separated defense-in-depth allowlist behind Access's own policy.
# Empty = everyone who passed Access is in.
TRANSACIONAL_ALLOWED_EMAILS=

# Local-dev escape hatch: with no Access JWT header present, requests
# run as this user instead of 401ing. Must stay unset (or "0") in prod.
TRANSACIONAL_DEV_BYPASS_AUTH=0
TRANSACIONAL_DEV_USER_EMAIL=dev@local
TRANSACIONAL_DEV_USER_NOME=Dev

# The shared domain-api this service persists everything through --
# there is no database here. Same API key style as the other modules
# (cch-api, harness-api): it authenticates as this service and can read
# any aggregate, needed to validate a conta owned by another module.
TRANSACIONAL_DOMAIN_API_URL=http://127.0.0.1:8000
TRANSACIONAL_DOMAIN_API_KEY=

# Max decoded size (bytes) accepted for anexoImagem uploads. 5MB default.
TRANSACIONAL_MAX_ANEXO_BYTES=5242880
