PORT=8023
BIND_HOST=

# Comma-separated origin(s) of the dashboard frontend SPA.
DASHBOARD_FRONTEND_ORIGINS=http://localhost:5173

# Cloudflare Access verification. Empty issuer disables JWT
# verification (dev only, pair with DASHBOARD_DEV_BYPASS_AUTH=1).
DASHBOARD_ACCESS_ISSUER=
DASHBOARD_ACCESS_AUD=
# Comma-separated allowlist, defense in depth behind Access's own
# policy. Empty means everyone who passed Access is in.
DASHBOARD_ALLOWED_EMAILS=

# Local dev escape hatch: with no Access JWT header, requests run as
# the DASHBOARD_DEV_USER_* identity below. Must stay unset in prod.
DASHBOARD_DEV_BYPASS_AUTH=1
DASHBOARD_DEV_USER_EMAIL=dev@local
DASHBOARD_DEV_USER_NOME=Dev

# Shared domain-api this service persists dashboard layouts through.
DASHBOARD_DOMAIN_API_URL=http://127.0.0.1:8000
DASHBOARD_DOMAIN_API_KEY=
