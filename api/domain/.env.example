# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change_me
POSTGRES_USER=domain
POSTGRES_DB=domain
API_PORT=8000

# Comma-separated key:label pairs — generate a key with:
#   openssl rand -hex 32
# Required on every /users route (see src/infrastructure/http/openapi.yaml).
DOMAIN_API_KEYS=change_me:my-client

# Per-IP throttle applied ONLY to requests without a valid API key
# (every such request ends in 401 anyway — this just slows down
# brute-forcing/scanning for a valid key). A valid key bypasses this
# entirely.
RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=5
